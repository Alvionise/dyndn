<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>dyndns</AssemblyName>
    <RootNamespace>DyndDns.TrayApp</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- The Release build targets win-x64 (self-contained, single file). Declaring the RID here as
         well makes a configuration-agnostic restore complete, so building Release on top of it
         resolves the win-x64 assets instead of failing with NETSDK1047. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />

    <!-- Pinned explicitly: the version Microsoft.Data.Sqlite pulls transitively is flagged by
         NU1903 (GHSA-2m69-gcr7-jv3q); 3.0.x carries the patched native library. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The only place the version is written: the assembly and file versions follow from it, and the release
         workflow passes the tag on top (publish.ps1 -Version), so a build carries the version it was released
         under. -->
    <Version>0.1.0</Version>
    <Authors>DyndDns contributors</Authors>
    <Description>Windows tray app that syncs a local domain list to a Keenetic router and routes it through a VPN interface.</Description>
    <Copyright>Copyright (c) 2026 DyndDns contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Alvionise/dyndn</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>keenetic;dns;vpn;tray;windows</PackageTags>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\*.ico" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="DyndDns.TrayApp.app.ico" />
    <EmbeddedResource Include="Assets\app.sync.ico" LogicalName="DyndDns.TrayApp.app.sync.ico" />
    <EmbeddedResource Include="Assets\app.error.ico" LogicalName="DyndDns.TrayApp.app.error.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DyndDns.TrayApp.Tests" />
  </ItemGroup>

</Project>
