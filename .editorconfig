root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cs,csproj,xaml}]
indent_size = 4

# --- Стиль кода: один для всего проекта, проверяется через dotnet format ---
# Пространства имён объявляются для файла, System.* идёт первым.
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Лишние using и упрощения, которые обязан применять dotnet format.
dotnet_diagnostic.IDE0005.severity = warning
csharp_style_prefer_collection_expression = true:warning
dotnet_diagnostic.IDE0044.severity = warning
dotnet_diagnostic.IDE0018.severity = warning
dotnet_diagnostic.IDE0019.severity = warning
dotnet_diagnostic.IDE0042.severity = warning
dotnet_diagnostic.IDE0063.severity = warning
dotnet_diagnostic.IDE0330.severity = warning

# Мёртвый код не должен доживать до ревью: его находит сборка, а не читатель. IDE0051/IDE0052 —
# неиспользуемые приватные члены, IDE0060 — параметр, который никто не читает, IDE0059 — присваивание,
# значение которого не используется.
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning
dotnet_diagnostic.IDE0059.severity = warning

# Стиль проекта — явные конструкторы; основные конструкторы не используем.
dotnet_diagnostic.IDE0290.severity = none

# Осознанно не применяем эти анализаторы: сервисы намеренно оставлены экземплярными
# (они внедряются и подменяются целиком), публичные контракты описаны интерфейсами,
# а микроптимизации вроде static readonly вместо аргумента-массива и GeneratedRegex
# дают шум без выигрыша на этих объёмах данных.
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1826.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.SYSLIB1045.severity = none
dotnet_diagnostic.SYSLIB1054.severity = none

[*.{json,yml,yaml,md}]
indent_size = 2

[*.ps1]
end_of_line = crlf
indent_size = 4

[*.{ico,png,jpg,zip,exe}]
insert_final_newline = false
